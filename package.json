{
  "name": "mcp-browser-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "agent-server": "pnpm -F agent-server start",
    "extension": "pnpm -F chrome-extension dev",
    "extension:build": "pnpm -F chrome-extension build",
    "test": "pnpm -F agent-server test",
    "eval": "pnpm -F agent-server eval",
    "eval:memory": "pnpm -F agent-server eval:memory",
    "bench": "pnpm -F agent-server bench",
    "report": "pnpm -F agent-server report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "rimraf node_modules **/node_modules **/dist",
    "build": "pnpm -r build"
  },
  "scripts:info": {
    "test": "单测：108 个 node:test 行为测试，锁编排层不变量",
    "eval": "黄金评测集：10 个 case 端到端阅卷（真实调 LLM，约花几分钱，耗时 1-2 分钟）",
    "eval:memory": "浏览记忆 A/B 对照实验（recall@3 / 记忆增益）",
    "bench": "压缩保真度基准：滚动摘要 vs 截断 vs 不压缩",
    "report": "读成本台账出报表（纯读文件不调模型，不花钱）"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,mjs,cjs,json,md,vue,html,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.0.0"
  }
}
