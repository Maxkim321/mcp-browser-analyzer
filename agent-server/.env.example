
# P8 记忆混合检索（方舟 /embeddings；不配置 = 纯 BM25 行为零变化）
# EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# EMBED_API_KEY=
# EMBED_MODEL=doubao-embedding-vision
# MEMORY_RETRIEVAL=auto

# P9 MCP server 接入（JSON 数组；未配置 = 不启动）
# MCP_SERVERS=[{"name":"fs","command":"npx","shell":true,"args":["-y","@modelcontextprotocol/server-filesystem","D:/your-notes-dir"]}]

# agent 单次任务最大推理轮次（默认 10；自动投递长流程建议 24）
# AGENT_MAX_ITERATIONS=24
