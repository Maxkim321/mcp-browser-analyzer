# ===== 必填：审查用的 LLM（沿用项目 ARK_ 前缀，OpenAI 兼容 / DeepSeek）=====
# 复制到 ai-code-review/.env（.env 已被 gitignore，不会提交）
ARK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 可选，默认 DeepSeek
ARK_BASE_URL=https://api.deepseek.com
ARK_MODEL=deepseek-chat

# ===== 仅当用 --platform github --post 回贴到 PR 时才需要 =====
# 在 GitHub > Settings > Developer settings > Personal access tokens 生成（需 repo 权限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ===== 仅当用 --platform gitlab --post 时（若有 GitLab）=====
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx